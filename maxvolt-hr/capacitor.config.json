{
  "appId": "com.maxvolt.hr",
  "appName": "Maxvolt One",
  "webDir": "dist",
  "backgroundColor": "#F2F2F7",
  "server": {
    "url": "https://maxone.maxvoltenergy.com",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F2F2F7"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F2F2F7"
  },
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#F2F2F7",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
