*.local

# Regenerated by `npx cap sync ios` every time — Capacitor computes these
# local package paths with the OS's own path separator (Node's path.relative),
# so a copy committed from Windows breaks Swift Package Manager on macOS
# ("Missing package product 'CapApp-SPM'", since SPM can't parse backslash
# paths) and vice versa. Never commit it — each machine regenerates its own
# correct copy on `cap sync`/`cap open ios`.
ios/App/CapApp-SPM/Package.swift

